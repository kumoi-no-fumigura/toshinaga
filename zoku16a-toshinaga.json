 "poems": [
  {
   "seq": "1",
   "text": "日にみかき風にはちるかぬきみたる柳のいとの露のしら玉",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "うへたつるわか木の梅の花見てそ我老らくの春もしらるゝ",
   "kana": "",
   "speaker": "從三位侍從俊長",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "たちかへる神代のはるのおもかけも霞にこもる天のかく山",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "よそまてはしらする程の風もなし軒端にふかき梅の匂ひを",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山かせのはらふかすみのうす衣たちかねてこそ春も寒けれ",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "老てなをことしの春はかすむ夜の月を淚になにかゝこたん",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あさなきの松浦かおきのはる〓〓と霞にきえてヽく舟もなし",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "はる雨の空はかすみてくるゝ日におつるも見えぬ軒の玉水",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "春はなをあさゝは水の朝ヽこほりいつとけ初てわかなつまゝし",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "見るまゝに家路忘れておのゝえもくちはてぬへき花のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いつのまに跡をもつけむ積るかとみるよりきゆる春のあは雪",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "身の程の春をはしらていたつらに老となるまて花になれつゝ",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "風わたる水のこゝろもすゝしきは露の玉ちる池の蓮葉",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "雲にのみまかひし花のうらみさへのこらぬ春のあとの山風",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "心して誘はぬ風のひまもあらはちるをやいとゝ花にかこたん",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "をとはかり影ゆく水のすゝしきはしけるうき田のもりの夏草",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "花鳥のなこりをあとに殘しをきていつくにけふは春の行らん",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "河風もみそきの袖に吹たちて秋にそかゝる浪のしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "色も香も袖にとまらて花ころもたちかへてうき夏はきにけり",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "音かはる風のほかにも夕日さすおかへの松に秋は見えけり",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夏はきぬうす花そめの袖の香もかはるみとりの衣手のもり",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "吹たひに露はとまらてなみたのみ袂に殘る荻のゆふかせ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "まてしはしむかしかたらむほとゝきす我も老そのもりの下影",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "あき萩のしたゆく水もをのつから花の色なる野田の玉河",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "うの花のさきそふころは玉川の岸による波よるとしもなし",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "山かせの身にしむ色のいかならんみやこの空も秋のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "開殘す人のためとやほとゝきす里かもつかすれなつくすらん",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "なかめわひ身のうき事もあはれさも思ひそわかぬ秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "ほしかねていくかへぬらん河內女か手ひきの糸の五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "我なみた秋のあはれにおもなれてをくともしらぬ袖のゆふ露",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "さきなかすにふの河水まさるらし舟もかよはぬ五月雨のころ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "つま戀のおもひつきせぬ鹿の音によその寢覺の袖もぬれつゝ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "かゝりさす早瀬の川の鵜かひ舟のほれはあくるみしかよの空",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "あらしふく嶺の木のまを出かねて松の下てるゆふくれの月",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "うき秋をなくさめなからはては又なかむる月に袖ぬらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "思ふ方に心ひき野の靑つゝらくる夜やあると待もはかなし",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "朝日やまみねもふもともたつ霧に漕いてゝまよふ宇治の川舟",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "尋ぬともあとさへ見えし身を秋の霜をく野へのもすの草くき",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "殘るかと見えし日影もくれはてゝきりにしつめる遠かたの山",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いのれはと賴むをやかて命にてこひしなぬ身を神にまかせん",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "龍田河うつろふ影もかはりけり嶺のこすゑをそむる時雨に",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "玉つさの通ふをやかてしるへにて戀のたゝちに迷はすもかな",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夕つく日うつろふ雲のくれなゐに又ふりいつる村しくれかな",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "なにはなるあくやの簾ひまとめてとへかし人のかけて思はゝ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "山かけのみちは落葉やつもるらん雪よりさきもとふ人はなし",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "いつの間にうき鳥の音をいとはましあふも別れとあか月の空",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "庭の面の木葉の秋の色をさへしはしとめしと吹あらしかな",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "とし月もつもるうらみの戀ころも淚になるゝ袖やくちなん",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "わかの浦やいり江の松は雪はれて日かけにみかく玉津島山",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "とけかぬる人の心はかたいとの苦しやさのみこなたはかりは",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "今朝はなとともの宮つこたゆむ覽はらはぬ雪のこゝのへの庭",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "下にのみいつまて思ひ亂れあしのねにあらはれて人を戀はや",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "みなといりの芦まをわけて漕舟のいかなる江にか又さはる覽",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "ふけにけりみつのとまりの小夜衛大まち戀て月になくこゑ",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "いかさまにわか兼ことを殘さましわすれん後も思ひいつやと",
   "kana": "",
   "speaker": "",
   "page": 142,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "別路のうきにもたへておなし世につれなやひとり有明の月",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "たくひなきはるの物とやむめかゝの色にも香にも心そむらん",
   "kana": "",
   "speaker": "花になれ行春のうくひす",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "千代ふともよも盡はてし和歌の浦の松をたねなる大和〓とのは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "ふる郷の軒端の月のかすむ夜にむかし忍ふとにほふ梅かゝ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "をく露は風にみたれてあを柳のはなたの糸をそめてほすえ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "あかし潟宮こもとをしありかよふ夢さへ浪のよるのうきれは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "しらみあふ木のまの花をひかりにて霞むもしらぬ春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "けふいく日都へたてゝあまさかるひなの中やま雲そかゝれる",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "くもるとも霞める空はみえわかてふるとしもなきけさの春雨",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "行すゑの雲のなみらやかすむらんいやとをさかる春の膓かね",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "我みちも今はあさかの山の井のくみたえなはと袖ぬらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "いかにせむおなし山路のさくら狩花にはあはてけふも暮なは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "うつゝかと思ふまよひの世の中を夢としるより驚かれつゝ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "萬代の春をうつしてかゝみやまちりもくもらぬ花の影かな",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あかて見る心のいろはうつろはて花にちとせの春もへぬへし",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "うきをたに者といへはしのふかな老はいかなる心なるらん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "さけはちるならひは花の恨みかな誘ふを風のとかになしても",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "いつくともかせのやとりはさたまらて空にみたるヽ花の自雪",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "四方の海や風おさまれる君か代に露もみたれぬあし原の國",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "春ひさすひかりのとかに匂ふらし君かちとせの松の藤なみ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "山吹の底にうつろふ影しあれはおられぬなみの花かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "けふ〓とにしたひなれぬる花鳥のおなしなこりの春の別れ路",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "浪のうへにかたふく月のいり海や夜も明わたるあまの橋たて",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "夏ころもたつ〓ややききならひともおもはてしたふ花の袖かな",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "この道をあふけは高しあさか山あさくはいかゝ思ひいるへき",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "夕やみは月にかはりて白妙にさく卯の花や光そふらむ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "まとろまぬ心つくしのそのまゝにまつ夜ひさしき郭公かな",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "あさか山あさくはあらぬ道そとやふかくも人のたつね入らん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "村雨のもりのしつくにぬれつゝもしゐて語らふほとゝきす哉",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "身をつくしふかきしるしも中〓〓に見えぬ入江の五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "なかめやるあはれひとつに行すゑも思ひわひぬる秋のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "あやめふく軒の下露おちそひてにほふもすゝしむら雨の空",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "人とはぬむくらのやとの秋風に思ひある身も衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "たれとしもわきてしのはぬ袖の音のむかしこひしき軒の橋",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "そめわけし露も時雨もあらはれてかたえ色そふ秋のもみちは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "なには人おのれはたかぬあし火そとみるやいり江の螢成らん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "ちりかゝるもみちなかれて山川の行瀨の水もふかき〓くれなゐ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "かゝりさす早瀨の河のうかひ舟のほりもはてすあくる夜半哉",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "はかなしやしくるゝ雲に誘はれて行衞もしらぬ秋のわかれは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "かた岡の檜の葉わけてふく風にうつる夕日のかけそすゝしき",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "曉のねさめの空のしくれまて袖にしられて冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "闘へなるわさ田のいなは吹風にはやうちなひき秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "見るまゝに月は空行山のはのおなし雲間にふるしくれ哉",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "心してたちなへたてそあまの川八十のふなつの秋のゆふ霧",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "をく霜にかれ野のま葛埋もれてかへらぬ秋をうらみかねつゝ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "我ならぬ人の袖にもをくつゆやなへての秋のあはれなるらん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "いたつらにちるや紅葉のあすか風わたるもつらし瀨々の岩橋",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "ひとこそあれ軒端の〓のをとはして秋風かよふ山したの庵",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "よし野河はや瀨のなみのよる〓とによとむやむすふ氷なるらん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "あたなりや露もてゆつる秋はきの花のまかきの風のやとりは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "さゆる夜は氷のとこにふしわひてうきねそたえぬ池のおし鳥",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "女郞花おほかる野への草枕名にのみめてゝいく夜むすはん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "代々まてもたえぬ道とや濵千鳥かはらぬわかの浦になくらむ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "ふけて行秋もよさむになく虫のねさめかれぬる蓬生のやと",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "猶さりにわけこし人の跡たにもけふはたえぬる庭のしら雪",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "とをさかるあまのをふねにまかふらし浦のとわたる秋の初鴈",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "夜のほとにつもりにけりな今朝はゝやまかきの竹の雪の下折",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "高砂の尾上の月のふくる夜にあらしをわけてかよふしかのね",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "はつ瀨河せきもとゝめぬ年なみに老のほかなる袖もぬれつゝ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "名のみしてくもるもつらし久かたの中なる里のあきの夕霧",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "秋はなをわるて見よとそてりまさる雲ゐの月のおなし光も",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "限なく思ひいりてもいかならんまよふ戀路のはてをしらすは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "さゝなみやにほてる月に〓とゝはん古きみやこの秋はいかにと",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "見てもなをいつ面影をうつさまし涙にやかてくもろかゝみは",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "あくかるゝ心のかきりなかめてもはてなき空の月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "我にのみしけるもつらししのふ草忘るゝたねを人もをしへよ",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "おもひ出のある昔をもおほえぬに月にはいつの戀しかるらん",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "おほえすよいつの人間にゆるしけん袖よりほかにあまる淚は",
   "kana": "",
   "speaker": "",
   "page": 143,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "おもひかれおつるなみたの瀧津瀨は心の中にせくかたもなし",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "しつかなるねさめの友とおもふにも泪にくもる閨のともし火",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "行すゑの山またやまにかゝるえこえつる跡の嶺のしら雲",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "いたつらにあはぬなけきの數そへてちきらぬ中に行月日哉",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "忘れめやみほのおきつのはるかなるきよみか關のあけ方の空",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "我袖もねにあらはれてしほかせになみこす浦の松はつれなし",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "なにはかたなきたる蜑の浪間よりほのかに見えていつる釣舟",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "たえすたつふしの煙にたくへてもなを時しらぬ身の思ひかな",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "行水のなみのたかせのはやけれはさゝぬにくたるよとの河舟",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "袖はなをなみたのほかにそほちきぬつらきわかれの道芝の露",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "日の本やみつのはま松年をへてくもらぬ千代の影やそふらん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "思ひれの夢のたゝちやいたつらに行てはかへる心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "いく千世も君そみるへき九重や御かきの竹のおなしみとりを",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "なれし夜のおなし袂にやとりきておも影はかりありあけの月",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "たちかへりみやこの空の月みても思ひそいてむさやの中山",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "底ふかみ入江におふるあしのねの下ふしならは人にしられし",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "たれにかはやとをもからむ草まくら夕風さむし野路のしの原",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "猶さりの心にかけてまつよひのふけぬほとこそたのみ成けれ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "うらかせにほかゆく舟のうき枕袖こそぬるれみる夢もなし",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "いかにせん我玉のをもたえぬへしいまたになけの情かけすは",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "こゝろのみ又うき世にやかへらましみ山のさとの夕暮のそら",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "はかなくもまとろむ程を契にてあふとみる夜の夢そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "たちのほる田なかのいほの夕烟よそにみるこそ心ほそけれ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "ひとりぬる床のさむしろしきしのひ幾夜かつもる恨なるらん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "つかふへき道は一つそ君のため神のためにと名をはわけても",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "見る月のかけもくもらてあふ夜にそ淚の雨のはれまなりける",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "さても我か身のおもひてになにをして今行末の人にかたらむ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "さゝ島や磯こす浪のよる〓〓はねもせて袖をぬらしそへつゝ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "人とはゝいかゝこたへんとの葉もおよはぬ法のふかき心を",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "むくひとやさきの世かけて恨みまし今更つらき人のこゝろを",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "くもりなき御世をそてらすます鏡うつす光の日のくまの宮",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "須磨のあまの鹽やき衣いかにしてなれにし中のまとを成らん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "龜のおのいはれの松のかくしつゝとにもかくにも萬代そへん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "吹かはるあらしにつれてかへるえおのへの鐘のあかつきの聲",
   "kana": "",
   "speaker": ".條案愚點廿首",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "あはれしるゆふつけ島のねにそへて淚おちそふあかつきの空",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "かなしきはそのことゝなき夕暮のなかめにかゝる空のうき雲",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "すまのあまの鹽やき衣うらみわひなをもまとをにぬるゝ柚哉",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "あくかれて我身にそはぬ心こそこひのたゝちのしるへえけれ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "さそなけに涼しかるらんいつみなるしのたの森の千枝の下風",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "しの薄しのひにきゝし風の音のほにあらはるヽ秋はきに",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "色ふかくうつりにけりなあきのゝにさくや眞萩の花のした露",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "けふみれはあやめをふかぬ軒端こそ中〓〓〓ささの庵なりけれ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "みやきのゝ木の下くらき夕霧に萩のにしきのなかやたえなん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "いそけとも五月も末になりにけりこれやおくての早苗成らん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "秋かせの露ふきはらふ花すゝき袖にたまらぬ玉かとそみる",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "こしかたを思ふにつけて今をさへ花たちはなにまたや忍はむ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "よそはゝや明ゆくまてにともしゝては山隱れにのこる夜半哉",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "秋の田のいな葉をしなみそよくえむれたつ屬のをのか羽風に",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "ひつ河にふねさしわたすかち人の木幡にかよふ五月雨のころ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "たちこむる霧のとたえの夕日影さすかに見えて膓はきにけり",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "天河こほりをわたるふねなれやさやけき月にわたる〓かね",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "とふ螢うつれる影やいけ水のそこの玉ものひかりなるらん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "かゝりさす影かとみれは大井河いり江をかけてとふほたる哉",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "をくら山あさ霧かくれなく鹿ははれぬおもひに妻やこふらん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "そこまてもかけをうつしてみわ河のきよきなかれにとふ螢哉",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "山の端をいてつる月にきこゆなりおなし尾上のさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "ふきおろすあらしの山の麓にもきえぬ夜川のかゝり火のかけ",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "高砂の尾上のいほやいてそむる月のあたりにちかくすむらん",
   "kana": "",
   "speaker": "",
   "page": 144,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
